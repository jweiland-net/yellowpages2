<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>yellowpages2.flex_forms:sheetGeneral</sheetTitle>
                <type>array</type>
                <el>
                    <settings.pidOfDetailPage>
                        <label>yellowpages2.flex_forms:pidOfDetailPage</label>
                        <config>
                            <type>number</type>
                            <default>0</default>
                        </config>
                    </settings.pidOfDetailPage>
                    <settings.pidOfListPage>
                        <label>yellowpages2.flex_forms:pidOfListPage</label>
                        <config>
                            <type>number</type>
                            <default>0</default>
                        </config>
                    </settings.pidOfListPage>
                    <settings.presetTrade>
                        <label>yellowpages2.flex_forms:presetTrade</label>
                        <config>
                            <type>select</type>
                            <renderType>selectTree</renderType>
                            <renderMode>tree</renderMode>
                            <foreign_table>sys_category</foreign_table>
                            <foreign_table_where>AND sys_category.sys_language_uid IN (-1, 0) ORDER BY
                                sys_category.sorting ASC
                            </foreign_table_where>
                            <size>10</size>
                            <autoSizeMax>20</autoSizeMax>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                            <treeConfig>
                                <appearance>
                                    <expandAll>1</expandAll>
                                    <maxLevels>99</maxLevels>
                                    <showHeader>1</showHeader>
                                </appearance>
                                <parentField>parent</parentField>
                            </treeConfig>
                        </config>
                    </settings.presetTrade>
                    <settings.district>
                        <label>yellowpages2.flex_forms:district</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <foreign_table>tx_yellowpages2_domain_model_district</foreign_table>
                            <items type="array">
                                <numIndex index="0">
                                    <label>
                                        yellowpages2.db:tx_yellowpages2_domain_model_company.district.pleaseChoose
                                    </label>
                                    <value></value>
                                </numIndex>
                            </items>
                            <size>1</size>
                            <minitems>0</minitems>
                        </config>
                    </settings.district>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
