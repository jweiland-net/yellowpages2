plugin.tx_yellowpages2 {
  view {
    templateRootPaths {
      0 = EXT:yellowpages2/Resources/Private/Templates/
      1 = {$yellowpages2.templateRootPath}
    }
    partialRootPaths {
      0 = EXT:yellowpages2/Resources/Private/Partials/
      1 = {$yellowpages2.partialRootPath}
    }
    layoutRootPaths {
      0 = EXT:yellowpages2/Resources/Private/Layouts/
      1 = {$yellowpages2.layoutRootPath}
    }
  }

  persistence {
    storagePid = {$yellowpages2.storagePid}
  }

  # Do not override the page settings of the Site Set with empty FlexForm values
  ignoreFlexFormSettingsIfEmpty = pidOfDetailPage,pidOfListPage,pidOfSearchResults

  settings {
    pidOfMaps2Plugin = {$yellowpages2.pidOfMaps2Plugin}
    startingUidForCategories = {$yellowpages2.startingUidForCategories}
    uidOfDefaultDistrict = {$yellowpages2.uidOfDefaultDistrict}
    pidOfDetailPage = {$yellowpages2.pidOfDetailPage}
    pidOfListPage = {$yellowpages2.pidOfListPage}
    pidOfManagementPage = {$yellowpages2.pidOfManagementPage}
    pidOfSearchResults = {$yellowpages2.pidOfSearchResults}
    userGroup = {$yellowpages2.userGroup}
    mapOptions {
      zoom = 12
      mapTypeId = google.maps.MapTypeId.HYBRID
      panControl = 1
      zoomControl = 1
      mapTypeControl = 1
      scaleControl = 1
      streetViewControl = 1
      overviewMapControl = 1
    }

    list {
      logo {
        width = 50c
        height= 50c
        minWidth = 50
        maxWidth = 50
        minHeight = 50
        maxHeight = 50
      }
      # Deprecated
      image < .logo
    }

    show {
      logo {
        width = 50c
        height= 50c
        minWidth = 50
        maxWidth = 50
        minHeight = 50
        maxHeight = 50
      }
      images {
        width = 240c
        height= 180c
      }
    }

    new {
      # Folder of the logo and the images uploaded in the company form
      uploadFolder = 1:/user_upload/tx_yellowpages2/
      # CKEditor 5 of EXT:rte_ckeditor for rich text elements in the company form
      richText {
        enable = {$yellowpages2.form.richText.enable}
        # Comma separated identifiers of form elements
        elements = {$yellowpages2.form.richText.elements}
        # Folder with the translations of CKEditor 5 like de.js
        translationsPath = {$yellowpages2.form.richText.translationsPath}
      }
    }

    # Special configuration for the company form based on EXT:form
    # See EXT:yellowpages2/Configuration/Form/Company.form.yaml which values are possible
    overrideForm {
      renderables.0.renderables.19.properties.saveToFileMount < plugin.tx_yellowpages2.settings.new.uploadFolder
      renderables.0.renderables.20.properties.saveToFileMount < plugin.tx_yellowpages2.settings.new.uploadFolder
      renderables.0.renderables.21.properties.saveToFileMount < plugin.tx_yellowpages2.settings.new.uploadFolder
      # Be careful: Only ONE page UID is allowed here
      finishers.1.options.databaseColumnMappings.pid.value = {$yellowpages2.form.storagePid}
      finishers.2.options.variables.pidOfManagementPage = {$yellowpages2.pidOfManagementPage}
      finishers.4.options.pageUid = {$yellowpages2.pidOfManagementPage}
    }

    glossary {
      mergeNumbers = 1
      showAllLink = 1
    }

    pageBrowser {
      class = JWeiland\Yellowpages2\Pagination\CompanyPagination
      itemsPerPage = {$yellowpages2.pageBrowser.itemsPerPage}
    }
  }
}
