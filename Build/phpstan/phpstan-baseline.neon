parameters:
	ignoreErrors:
		# glossary2 8.0.0 types the queries of GlossaryService as Glossary generics,
		# although the service is meant to be used with models of other extensions.
		-
			message: '#^Parameter \#1 \$extbaseQuery of method JWeiland\\Glossary2\\Service\\GlossaryService\:\:getLetterConstraintForExtbaseQuery\(\) expects#'
			identifier: argument.type
			count: 1
			path: ../../Classes/Domain/Repository/CompanyRepository.php

		-
			message: '#^Parameter \#1 \$queryBuilder of method JWeiland\\Glossary2\\Service\\GlossaryService\:\:buildGlossary\(\) expects#'
			identifier: argument.type
			count: 1
			path: ../../Classes/EventListener/AddGlossaryEventListener.php

		-
			message: '#^Property JWeiland\\Yellowpages2\\Domain\\Model\\Company\:\:\$images on left side of \?\?\= is not nullable nor uninitialized\.$#'
			identifier: nullCoalesce.initializedProperty
			count: 1
			path: ../../Classes/Domain/Model/Company.php

		-
			message: '#^Property JWeiland\\Yellowpages2\\Domain\\Model\\Company\:\:\$logo on left side of \?\?\= is not nullable nor uninitialized\.$#'
			identifier: nullCoalesce.initializedProperty
			count: 1
			path: ../../Classes/Domain/Model/Company.php

		-
			message: '#^Property JWeiland\\Yellowpages2\\Domain\\Model\\Company\:\:\$mainTrade on left side of \?\?\= is not nullable nor uninitialized\.$#'
			identifier: nullCoalesce.initializedProperty
			count: 1
			path: ../../Classes/Domain/Model/Company.php

		-
			message: '#^Property JWeiland\\Yellowpages2\\Domain\\Model\\Company\:\:\$trades on left side of \?\?\= is not nullable nor uninitialized\.$#'
			identifier: nullCoalesce.initializedProperty
			count: 1
			path: ../../Classes/Domain/Model/Company.php

		-
			message: '#^Method JWeiland\\Yellowpages2\\Event\\PostProcessControllerActionEvent\:\:getCompanyController\(\) should return JWeiland\\Yellowpages2\\Controller\\CompanyController but returns TYPO3\\CMS\\Extbase\\Mvc\\Controller\\ActionController\.$#'
			identifier: return.type
			count: 1
			path: ../../Classes/Event/PostProcessControllerActionEvent.php
