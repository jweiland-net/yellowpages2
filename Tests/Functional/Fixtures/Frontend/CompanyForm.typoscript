# Frontend configuration of EXT:form of the site set typo3/form.
# The form sets of EXT:form, EXT:maps2 and EXT:yellowpages2 are discovered automatically.
@import 'EXT:form/Configuration/TypoScript/setup.typoscript'
@import 'EXT:yellowpages2/Configuration/Sets/Yellowpages2/setup.typoscript'

page = PAGE
page {
  10 = EXTBASEPLUGIN
  10 {
    extensionName = Yellowpages2
    pluginName = Management
  }
}
