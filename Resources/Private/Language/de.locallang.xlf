			<trans-unit id="email.subject.inform.user">
				<source>Your company record is out of date</source>
				<target>Ihr Firmeneintrag bei Pforzheim ist veraltet</target>
			</trans-unit>
			<trans-unit id="email.subject.deactivated.user">
				<source>Your company record has been deactivated</source>
				<target>Ihr Firmeneintrag bei Pforzheim wurde deaktiviert</target>
			</trans-unit>
			<trans-unit id="email.subject.deactivated.admin">
				<source>A company record has been deactivated</source>
				<target>Ein Firmeneintrag bei Pforzheim wurde deaktiviert</target>
			</trans-unit>
			<trans-unit id="email.subject.activate">
				<source>A record was activated</source>
				<target>Ein Datensatz wurde aktiviert</target>
			</trans-unit>
			<trans-unit id="email.body.inform.user">
				<source><![CDATA[
					<p>Dear customer</p>
					<p>Your company entry %2$s (%1$s) will be outdated next month</p>
					<p>Please login at %3$s and update your data.</p>
					<p>Your team of Pforzheim</p>]]>
				</source>
				<target><![CDATA[
					<p>Sehr geehrte Damen und Herren</p>
					<p>Ihr Firmeneintrag %2$s (%1$s) wird in einem Monat deaktiviert.</p>
					<p>Bitte loggen Sie sich bei uns auf der Seite: %3$s ein und überprüfen Sie Ihre Daten.</p>
					<p>Ihr Team von Pforzheim</p>]]>
				</target>
			</trans-unit>
			<trans-unit id="email.body.deactivated.user">
				<source><![CDATA[
					<p>Dear customer</p>
					<p>Your company entry %2$s (%1$s) now been deactivated</p>
					<p>Your team of Pforzheim</p>]]>
				</source>
				<target><![CDATA[
					<p>Sehr geehrte Damen und Herren</p>
					<p>Ihr Firmeneintrag %2$s (%1$s) wurde deaktiviert.</p>
					<p>Ihr Team von Pforzheim</p>]]>
				</target>
			</trans-unit>
			<trans-unit id="email.body.deactivated.admin">
				<source><![CDATA[
					<p>Dear admin</p>
					<p>The company entry %2$s (%1$s) has now been deactivated</p>]]>
				</source>
				<target><![CDATA[
					<p>Sehr geehrte Damen und Herren</p>
					<p>Der Firmeneintrag %2$s (%1$s) wurde deaktiviert.</p>]]>
				</target>
			</trans-unit>


