      <trans-unit id="email.body.inform.user">
        <source><![CDATA[
					<p>Dear customer</p>
					<p>Your company entry %2$s (%1$s) will be outdated next month</p>
					<p>Please login at %3$s and update your data.</p>
					<p>Your team of Pforzheim</p>]]></source>
        <target state="translated"><![CDATA[
					<p>Tisztelt ügyfelünk!</p>
					<p>%2$s (%1$s) cégbejegyzése jövő hónapban elavulttá válik</p>
					<p>Kérjük, jelentkezzen be a(z) %3$s címen, és frissítse adatait.</p>
					<p>Az Ön Pforzheim-i csapata</p>]]></target>
      </trans-unit>
      <trans-unit id="email.body.deactivated.user">
        <source><![CDATA[
					<p>Dear customer</p>
					<p>Your company entry %2$s (%1$s) now been deactivated</p>
					<p>Your team of Pforzheim</p>]]></source>
        <target state="translated"><![CDATA[
					<p>Tisztelt ügyfelünk!</p>
					<p>%2$s (%1$s) cégbejegyzése deaktiválásra került</p>
